AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=

# Absolute path to a Google Cloud service-account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=

# Maximum accepted upload size in megabytes.
MAX_UPLOAD_SIZE_MB=256

# Maximum original video size accepted by the native FFmpeg fallback.
MAX_VIDEO_UPLOAD_SIZE_MB=8192

# Max simultaneous in-flight transcriptions across direct requests and jobs.
MAX_CONCURRENT_TRANSCRIPTIONS=2

# Max queued or processing background jobs before new large uploads are rejected.
MAX_ACTIVE_BACKGROUND_JOBS=4

# Comma-separated frontend origins allowed to call the backend.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:3100,http://localhost:3100
